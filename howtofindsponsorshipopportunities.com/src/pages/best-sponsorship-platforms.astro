          <p class="mt-1 text-sm text-gray-500">{o.channels}. Score {o.total} of 9 (selling {o.sellScore}, price {o.priceScore}, access {o.accessScore}). Read {o.read}.</p>
          <p class="mt-3 text-gray-700">{o.summary}</p>
          <p class="mt-3 text-gray-700"><strong class="text-gray-900">Price and fees.</strong> {o.price}{o.priceNote ? ` ${o.priceNote}` : ''}</p>
          <p class="mt-3 text-gray-700"><strong class="text-gray-900">Who can use it.</strong> {o.access}</p>
          <p class="mt-3 text-gray-700"><strong class="text-gray-900">Where it falls short.</strong> {o.limit}</p>
          <p class="mt-3 text-sm text-gray-500">
            Sources:
            {o.sources.map((s, i) => (
              <Fragment>{i > 0 ? ', ' : ' '}<a href={s[0]} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 break-words">{s[1]}</a></Fragment>
