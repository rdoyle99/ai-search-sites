        <thead>
          <tr class="border-b-2 border-gray-300 align-bottom">
            <th class="py-3 pr-4 font-semibold text-gray-600">Criterion</th>
            <th class="py-3 pr-4 font-semibold text-gray-600">3 points</th>
            <th class="py-3 pr-4 font-semibold text-gray-600">2 points</th>
            <th class="py-3 pr-4 font-semibold text-gray-600">1 point</th>
            <th class="py-3 font-semibold text-gray-600">0 points</th>
          </tr>
        </thead>
        <tbody>
          {rubric.map((r) => (
            <tr class="border-b border-gray-200 align-top">
              <th scope="row" class="py-3 pr-4 font-medium text-gray-900">{r.criterion}</th>
              <td class="py-3 pr-4 text-gray-700">{r.s3}</td>
              <td class="py-3 pr-4 text-gray-700">{r.s2}</td>
              <td class="py-3 pr-4 text-gray-700">{r.s1}</td>
