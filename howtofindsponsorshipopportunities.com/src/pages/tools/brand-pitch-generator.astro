---
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../config';
import { SR } from '../../data/sr-stats';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Brand Pitch Email Generator",
  "applicationCategory": "BusinessApplication",
  "description": "Generate personalized sponsorship pitch emails based on the brand and your creator profile.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
};
---

<Base
  title="Brand Pitch Email Generator | Find Sponsorship Opportunities"
  description="Free tool: generate personalized sponsorship pitch emails to send to brands based on your creator profile and the brand you're targeting."
  schema={schema}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Brand Pitch Email Generator</h1>
    <p class="mt-4 text-lg text-gray-600">
      Fill in the details about yourself and the brand you want to pitch. We&rsquo;ll generate a draft sponsorship email. The draft contains no statistics of its own, so fill in every [bracket] with something true before you send it.
    </p>

    <div class="mt-10 space-y-6">
      <div class="p-6 border border-gray-200 rounded-lg bg-white">
        <h2 class="text-lg font-semibold text-gray-900">About You</h2>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="your-name" class="block text-sm font-medium text-gray-700">Your name</label>
            <input type="text" id="your-name" placeholder="Jane Doe" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="channel-name" class="block text-sm font-medium text-gray-700">Channel / brand name</label>
            <input type="text" id="channel-name" placeholder="TechReview Weekly" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="your-platform" class="block text-sm font-medium text-gray-700">Platform</label>
            <select id="your-platform" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
              <option value="YouTube channel">YouTube</option>
              <option value="Instagram account">Instagram</option>
              <option value="TikTok account">TikTok</option>
              <option value="podcast">Podcast</option>
              <option value="newsletter">Newsletter</option>
              <option value="Twitter/X account">Twitter / X</option>
            </select>
          </div>
          <div>
            <label for="your-audience" class="block text-sm font-medium text-gray-700">Audience size</label>
            <input type="text" id="your-audience" placeholder="Your subscriber or follower count" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="your-niche" class="block text-sm font-medium text-gray-700">Your niche</label>
            <input type="text" id="your-niche" placeholder="B2B SaaS tools for startups" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="your-metric" class="block text-sm font-medium text-gray-700">Best metric</label>
            <input type="text" id="your-metric" placeholder="Your best number, such as open rate or average views" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
        </div>
      </div>

      <div class="p-6 border border-gray-200 rounded-lg bg-white">
        <h2 class="text-lg font-semibold text-gray-900">About the Brand</h2>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="brand-name" class="block text-sm font-medium text-gray-700">Brand name</label>
            <input type="text" id="brand-name" placeholder="Notion" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div>
            <label for="contact-name" class="block text-sm font-medium text-gray-700">Contact first name</label>
            <input type="text" id="contact-name" placeholder="Sarah" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
          <div class="sm:col-span-2">
            <label for="brand-context" class="block text-sm font-medium text-gray-700">What the brand did recently (a launch, campaign or feature)</label>
            <input type="text" id="brand-context" placeholder="e.g., launched a new feature for teams" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" />
          </div>
        </div>
      </div>

      <div class="p-6 border border-gray-200 rounded-lg bg-white">
        <h2 class="text-lg font-semibold text-gray-900">Pitch Style</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <label class="flex items-center gap-2">
            <input type="radio" name="style" value="standard" checked class="text-blue-600" />
            <span class="text-sm">Standard pitch</span>
          </label>
          <label class="flex items-center gap-2">
            <input type="radio" name="style" value="data" class="text-blue-600" />
            <span class="text-sm">Data-led pitch</span>
          </label>
          <label class="flex items-center gap-2">
            <input type="radio" name="style" value="fan" class="text-blue-600" />
            <span class="text-sm">Existing fan pitch</span>
          </label>
        </div>
        <p class="mt-3 text-sm text-gray-500">Use the existing fan pitch only if you have really used the product and mentioned it to your audience.</p>
      </div>

      <button id="generate-btn" class="w-full px-6 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors">
        Generate Pitch Email
      </button>

      <div id="output" class="hidden">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-lg font-semibold text-gray-900">Your Pitch Email</h2>
          <button id="copy-btn" class="text-sm text-blue-600 hover:text-blue-800 font-medium">Copy to clipboard</button>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
          <p class="text-xs text-gray-500 mb-2">Subject line:</p>
          <p id="subject-line" class="font-semibold text-gray-900 mb-4"></p>
          <p class="text-xs text-gray-500 mb-2">Email body:</p>
          <div id="email-body" class="text-sm leading-relaxed whitespace-pre-wrap"></div>
        </div>
        <p class="mt-3 text-sm text-gray-600">
          Every number in this draft comes from what you typed, so check each one. Replace each [bracket] before you send. The draft mentions a media kit, so attach one: <a href="/tools/media-kit-builder/" class="text-blue-600 hover:text-blue-800 underline">build a media kit</a>. If you hear nothing back, see the <a href="/blog/sponsorship-follow-up-email/" class="text-blue-600 hover:text-blue-800 underline">sponsorship follow-up email templates</a>. For more templates and subject lines, see the <a href="/blog/cold-email-sponsorship-pitch/" class="text-blue-600 hover:text-blue-800 underline">sponsorship email template guide</a>.
        </p>
      </div>
    </div>

    <div class="mt-8 p-6 border border-blue-200 rounded-lg bg-blue-50">
      <p class="text-sm font-medium text-blue-900">Want the pitches sent for you?</p>
      <p class="mt-1 text-sm text-blue-700">
        For newsletters, <a href={SR.cta('brand-pitch-generator')} target="_blank" rel="noopener noreferrer" class="font-semibold underline">{siteConfig.product.name}</a> finds brands that sponsored similar newsletters, writes the pitch to the person who buys the ads, and sends it from its own mailboxes with follow-ups.
      </p>
      <a href={SR.cta('brand-pitch-generator')} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-md hover:bg-blue-700 transition-colors">
        See sponsors for your newsletter &rarr;
      </a>
    </div>
  </section>
</Base>

<script>
  document.getElementById('generate-btn')?.addEventListener('click', () => {
    const yourName = (document.getElementById('your-name') as HTMLInputElement).value || '[Your name]';
    const channelName = (document.getElementById('channel-name') as HTMLInputElement).value || '[Your channel]';
    const platform = (document.getElementById('your-platform') as HTMLSelectElement).value;
    const audience = (document.getElementById('your-audience') as HTMLInputElement).value || '[audience size]';
    const niche = (document.getElementById('your-niche') as HTMLInputElement).value || '[your niche]';
    const metric = (document.getElementById('your-metric') as HTMLInputElement).value || '[your best metric]';
    const brandName = (document.getElementById('brand-name') as HTMLInputElement).value || '[Brand]';
    const contactName = (document.getElementById('contact-name') as HTMLInputElement).value || 'there';
    const brandContext = (document.getElementById('brand-context') as HTMLInputElement).value;
    const style = (document.querySelector('input[name="style"]:checked') as HTMLInputElement).value;

    let subject = '';
    let body = '';

    if (style === 'standard') {
      const noticed = brandContext
        ? `I saw that ${brandName} ${brandContext}.`
        : `[One specific thing you saw ${brandName} do recently.]`;
      subject = `${brandName} × ${channelName}: sponsorship idea`;
      body = `Hi ${contactName},

${noticed}

I run ${channelName}, a ${platform} covering ${niche}. We have ${audience} with ${metric}.

I'd like to feature ${brandName} in [the specific placement and date you're offering]. I think a straightforward walkthrough of how ${brandName} solves [specific problem] would fit my audience.

I've attached my media kit with audience data and rates. Would you be open to a short call this week to discuss?

Best,
${yourName}`;
    } else if (style === 'data') {
      subject = `A sponsorship idea for ${brandName}, with my audience data`;
      body = `Hi ${contactName},

I run ${channelName}, a ${platform} covering ${niche}. Here is why I think ${brandName} fits my audience:

• ${audience}
• ${metric}
• [One fact about who reads you, from your own analytics: job titles, location or interests]

I'd like to feature ${brandName} in [the specific placement and date you're offering]. My media kit has the audience data behind this, and my rates.

Would you like me to send it?

Best,
${yourName}`;
    } else {
      const impressed = brandContext ? ` I was especially impressed that ${brandName} ${brandContext}.` : '';
      subject = `I already recommend ${brandName}. Make it official?`;
      body = `Hi ${contactName},

I've used ${brandName} for [how long] and mentioned it to my audience in [where and when].${impressed}

I run ${channelName}, a ${platform} covering ${niche}. We have ${audience} with ${metric}. I'd like to turn that into a paid, labeled sponsorship: [the specific placement and date you're offering].

I've attached my media kit. Is that something ${brandName} does?

Best,
${yourName}`;
    }

    document.getElementById('output')!.classList.remove('hidden');
    document.getElementById('subject-line')!.textContent = subject;
    document.getElementById('email-body')!.textContent = body;

    const fullText = `Subject: ${subject}\n\n${body}`;
    document.getElementById('copy-btn')?.addEventListener('click', () => {
      navigator.clipboard.writeText(fullText).then(() => {
        const btn = document.getElementById('copy-btn')!;
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy to clipboard', 2000);
      });
    });
  });
</script>
