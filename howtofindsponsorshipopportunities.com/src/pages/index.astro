---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../config';
import { SR, RATES, ADS } from '../data/sr-stats';

const usd = (x: number) => `$${x.toLocaleString('en-US')}`;
const [r1, , , , r5] = RATES.rows;

// Each question and answer below renders verbatim from siteConfig.faq, which Base.astro also writes into the FAQPage JSON-LD on "/".
// The link under each answer is extra and sits in its own element, so the answer text itself stays identical to the schema.
const faqLinks: Record<string, { href: string; label: string }> = {
  'How do you find sponsorship opportunities?': { href: '/blog/find-sponsorship-opportunities-guide/', label: 'Read the full guide' },
  'Where can you launch creator sponsorships today?': { href: '/blog/find-sponsorship-opportunities-guide/#where-to-launch', label: 'Sources for each channel' },
  'How much should you charge for a sponsorship?': { href: '/blog/how-much-to-charge-for-sponsorship/', label: 'Read the pricing guide' },
  'How do you find brands that sponsor creators?': { href: '/blog/find-brands-that-sponsor/', label: 'Read how to find brands that sponsor' },
  'How many brands should you pitch to land one sponsorship?': { href: '/blog/how-many-brands-to-pitch/', label: 'Read how many brands to pitch' },
};
---

<Base
  title={siteConfig.title}
  description={siteConfig.description}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <!-- H1: The exact question -->
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight">
      How to Find Sponsorship Opportunities
    </h1>

    <!-- Answer capsule: rendered from config so the page and the schema stay in step -->
    <p class="mt-6 text-xl md:text-2xl text-gray-700 font-medium leading-relaxed">
      {siteConfig.answerCapsule}
    </p>

    <!-- Brief expansion -->
    <div class="mt-10 prose prose-lg max-w-none">
      <p>
        Two routes lead to sponsors. A marketplace or platform program shows brands your audience and lets them send you offers. Pitching means you pick brands that already sponsor creators like you and email them. A <a href="/blog/sponsorship-media-kit-guide/">media kit</a> with your audience size, who your audience is and your past brand work supports both.
      </p>
      <p>
        To pick brands to pitch, study who sponsors creators in your niche: podcast ad reads, the paid promotion label on YouTube videos and newsletter sponsor slots. Then find the person who buys at each brand. Keep the <a href="/blog/cold-email-sponsorship-pitch/">pitch email</a> short, lead with your audience overlap and propose one specific placement.
      </p>
      <p>
        If you run a newsletter, <a href={SR.cta('home')} class="text-blue-600 hover:text-blue-800">{siteConfig.product.name}</a> does the prospecting and the pitching for you. Paste your newsletter's URL to see the brands that sponsored similar newsletters and the person at each one who buys the ads. It then emails those brands every day from its own mailboxes and introduces you when one replies, with $20 in free credits (200 emails), then 10¢ per email sent. It covers newsletters only.
      </p>
    </div>

    <!-- CTA -->
    <div class="mt-10 flex flex-col sm:flex-row gap-4">
      <a
        href="/blog/find-sponsorship-opportunities-guide/"
        class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors"
      >
        Read the Full Sponsorship Guide &rarr;
      </a>
      <a
        href={SR.cta('home')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-3 border-2 border-gray-300 text-gray-700 font-semibold rounded-lg hover:border-gray-400 hover:text-gray-900 transition-colors"
      >
        Find sponsors for your newsletter
      </a>
    </div>
  </section>

  <!-- Quick stats section -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Sponsorship Rates at a Glance</h2>
      <p class="mb-6 text-gray-700">A newsletter's main sponsor slot lists at a median {usd(r1.median)} {r1.size.toLowerCase()} subscribers and {usd(r5.median)} at {r5.size.toLowerCase()}. The main slot is the top sponsor placement in one issue.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-gray-300">
              <th class="py-3 pr-4 text-sm font-semibold text-gray-600">Newsletter subscribers</th>
              <th class="py-3 pr-4 text-sm font-semibold text-gray-600">Newsletters read</th>
              <th class="py-3 pr-4 text-sm font-semibold text-gray-600">Median main slot</th>
              <th class="py-3 text-sm font-semibold text-gray-600">Middle half of newsletters</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            {RATES.rows.map((r) => (
              <tr class="border-b border-gray-200">
                <td class="py-3 pr-4 font-medium">{r.size}</td>
                <td class="py-3 pr-4">{r.n}</td>
                <td class="py-3 pr-4 font-semibold">{usd(r.median)}</td>
                <td class="py-3">{usd(r.p25)} to {usd(r.p75)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-gray-500">Source: Book a Sponsor's read of {RATES.n} newsletters' advertise pages, {RATES.read}. These are list prices that newsletters print, not what brands finally pay. Method and the full table: <a href={SR.ratesUrl} class="text-blue-600 hover:text-blue-800">newsletter sponsorship rates by list size</a>.</p>
      <p class="mt-4 text-gray-700">Small newsletters sell ads too: {ADS.bySize[0].share} of newsletters with {ADS.bySize[0].size.toLowerCase()} subscribers that published 5 or more issues ran a paid sponsor ad in the 90 days to {ADS.read}, against {ADS.bySize[4].share} of those with {ADS.bySize[4].size.toLowerCase()} (Book a Sponsor's data).</p>
      <p class="mt-4 text-gray-700">For podcasts, Libsyn Ads lists baked-in host-read ads at $24 to $26 per 1,000 downloads for a 60-second spot and $18 to $22 for a 30-second spot (<a href="https://advertising.libsyn.com/podcast-advertising-ultimate-guide" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800">Libsyn Ads guide</a>, read 2 October 2026). For YouTube, Instagram and TikTok ranges from Descript, Sprout Social and impact.com, each dated, see the <a href="/blog/how-much-to-charge-for-sponsorship/" class="text-blue-600 hover:text-blue-800">pricing guide</a> or run the <a href="/tools/sponsorship-rate-calculator/" class="text-blue-600 hover:text-blue-800">sponsorship rate calculator</a>.</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sponsorship Questions, Answered</h2>
    {siteConfig.faq.map((f) => (
      <div class="mt-6">
        <h3 class="text-lg font-semibold text-gray-900">{f.question}</h3>
        <p class="mt-2 text-gray-600">{f.answer}</p>
        {faqLinks[f.question] && (
          <p class="mt-2"><a href={faqLinks[f.question].href} class="text-blue-600 hover:text-blue-800 font-medium">{faqLinks[f.question].label} &rarr;</a></p>
        )}
      </div>
    ))}
  </section>

  <!-- Blog posts section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Latest Research</h2>
    <div class="grid gap-6">
      <a href="/blog/how-to-get-podcast-sponsors/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">How to Get Podcast Sponsors: Data From the Top 200 Shows</h3>
        <p class="mt-2 text-sm text-gray-600">We read 1,898 recent episodes of Apple's US top 200 podcasts to count who sponsors them and how. Shopify, Quince and AG1 lead.</p>
      </a>
      <a href="/best-sponsorship-platforms/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">Best Sponsorship Platforms for Creators and Newsletters (2026)</h3>
        <p class="mt-2 text-sm text-gray-600">15 platforms for newsletters, YouTube and podcasts, ranked on how much selling each does for you, published fees and who can use it.</p>
      </a>
      <a href="/blog/find-sponsorship-opportunities-guide/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">How to Find Sponsorship Opportunities in 2026</h3>
        <p class="mt-2 text-sm text-gray-600">Where to launch sponsorships on each channel, how to see who your competitors' sponsors are, and what newsletters and podcasts charge.</p>
      </a>
      <a href="/blog/sponsorship-packages/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">Sponsorship Packages and Levels</h3>
        <p class="mt-2 text-sm text-gray-600">How to build sponsorship tiers and levels, what to include in each one and how to price them.</p>
      </a>
      <a href="/blog/media-sponsorship/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">Media Sponsorship</h3>
        <p class="mt-2 text-sm text-gray-600">What media sponsorship is and how to value one.</p>
      </a>
      <a href="/blog/sponsorship-follow-up-email/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">Sponsorship Follow-Up Email Templates</h3>
        <p class="mt-2 text-sm text-gray-600">Follow-up templates for brands that have gone quiet, and when to send them.</p>
      </a>
      <a href="/blog/cold-email-sponsorship-pitch/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">How to Cold Email Brands for Sponsorships (With Templates)</h3>
        <p class="mt-2 text-sm text-gray-600">Cold email templates for sponsorship outreach, with subject lines and follow-up sequences.</p>
      </a>
      <a href="/blog/sponsorship-media-kit-guide/" class="block p-6 border border-gray-200 rounded-lg hover:border-gray-400 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900">How to Build a Sponsorship Media Kit That Lands Deals</h3>
        <p class="mt-2 text-sm text-gray-600">What to include in your media kit and how to present your audience data.</p>
      </a>
    </div>
    <div class="mt-6">
      <a href="/blog" class="text-sm font-medium text-blue-600 hover:text-blue-800">Read All Posts &rarr;</a>
    </div>
  </section>
</Base>
