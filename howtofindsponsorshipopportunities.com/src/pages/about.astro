---
import Base from '../layouts/Base.astro';
import { siteConfig } from '../config';
---

<Base
  title={`About | ${siteConfig.title}`}
  description={`${siteConfig.title} is a free resource on how to find and land sponsorship opportunities as a creator or publisher. Brought to you by ${siteConfig.product.name}.`}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">About This Site</h1>

    <div class="mt-8 prose prose-lg max-w-none">
      <p>
        <strong>How to Find Sponsorship Opportunities</strong> is a free resource built to give professionals a straight, data-backed answer to the question: <em>"How to Find Sponsorship Opportunities?"</em>
      </p>

      <p>
        The answer — <strong>through media kit building, brand research, and cold email pitching</strong> — comes from real-world data and industry research. This site breaks down the nuances so you can make informed decisions for your specific situation.
      </p>

      <p>
        This site is maintained by the team behind <a href={siteConfig.product.ctaUrl}>{siteConfig.product.name}</a>, which finds the brands already sponsoring newsletters in a niche and pitches them for the newsletter's owner. Sponsor Radar is operated by Sales.co.
      </p>

      <h2>Where the numbers come from</h2>

      <p>
        Newsletter sponsorship prices on this site come from Sponsor Radar's read of newsletters' own advertise pages, linked where they appear. Other figures cite their source on the page. Ranges with no source are rough guides, not measurements.
      </p>

      <h2>Contact</h2>

      <p>
        Questions or suggestions? Reach us at <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>.
      </p>

    </div>
  </section>
</Base>
